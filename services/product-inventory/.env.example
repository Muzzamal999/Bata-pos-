NODE_ENV=development
PORT=3002

DATABASE_URL=postgresql://product_user:product_pass@localhost:5433/product_db?schema=public

# Must be identical to identity-organization's JWT_ACCESS_SECRET - this service
# verifies access tokens issued by Service 1, it does not issue its own.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-min-32-chars

RABBITMQ_URL=amqp://bata:bata_pass@localhost:5672
RABBITMQ_EXCHANGE=product_inventory.events
OUTBOX_RELAY_ENABLED=true
