generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  CASH_IN
  CASH_OUT
}

// A cashier's cash-drawer session. Sales recorded while a shift is open
// reference it; closing a shift reconciles expected vs actual cash.
model Shift {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @db.Uuid
  branchId      String         @db.Uuid
  cashierId     String         @db.Uuid
  openingFloat  Decimal        @db.Decimal(12, 2)
  closingCash   Decimal?       @db.Decimal(12, 2)
  expectedCash  Decimal?       @db.Decimal(12, 2)
  variance      Decimal?       @db.Decimal(12, 2)
  status        ShiftStatus    @default(OPEN)
  openedAt      DateTime       @default(now())
  closedAt      DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sales         Sale[]
  cashMovements CashMovement[]
  refunds       Refund[]

  @@index([tenantId, branchId, status])
  @@index([tenantId, cashierId])
  @@map("shifts")
}

// Cash in/out during an open shift (petty cash, drops) - not a sale.
model CashMovement {
  id        String           @id @default(uuid()) @db.Uuid
  shiftId   String           @db.Uuid
  shift     Shift            @relation(fields: [shiftId], references: [id])
  type      CashMovementType
  amount    Decimal          @db.Decimal(12, 2)
  reason    String?
  createdAt DateTime         @default(now())

  @@index([shiftId])
  @@map("cash_movements")
}

enum SaleStatus {
  COMPLETED
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_WALLET
  OTHER
}

model Sale {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  branchId       String        @db.Uuid
  cashierId      String        @db.Uuid
  shiftId        String?       @db.Uuid
  shift          Shift?        @relation(fields: [shiftId], references: [id])
  status         SaleStatus    @default(COMPLETED)
  subtotal       Decimal       @db.Decimal(12, 2)
  discountTotal  Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal       Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  currency       String        @default("PKR")
  refundedAmount Decimal       @default(0) @db.Decimal(12, 2)
  refundedAt     DateTime?
  // Lets a retried/duplicate checkout submission return the original sale
  // instead of creating (and double-charging/double-deducting-stock for) a second one.
  idempotencyKey String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  lines          SaleLine[]
  payments       SalePayment[]
  refunds        Refund[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, cashierId])
  @@map("sales")
}

model SaleLine {
  id                  String       @id @default(uuid()) @db.Uuid
  saleId              String       @db.Uuid
  sale                Sale         @relation(fields: [saleId], references: [id])
  variantId           String       @db.Uuid
  // Snapshot at sale time - a receipt must read the same years later even if
  // the product is later renamed in Product & Inventory.
  productNameSnapshot String
  quantity            Int
  unitPrice           Decimal      @db.Decimal(12, 2)
  lineDiscount        Decimal      @default(0) @db.Decimal(12, 2)
  lineTotal           Decimal      @db.Decimal(12, 2)
  refundedQuantity    Int          @default(0)
  refundLines         RefundLine[]

  @@index([saleId])
  @@index([variantId])
  @@map("sale_lines")
}

model SalePayment {
  id        String        @id @default(uuid()) @db.Uuid
  saleId    String        @db.Uuid
  sale      Sale          @relation(fields: [saleId], references: [id])
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  reference String?
  createdAt DateTime      @default(now())

  @@index([saleId])
  @@map("sale_payments")
}

model Refund {
  id                String       @id @default(uuid()) @db.Uuid
  saleId            String       @db.Uuid
  sale              Sale         @relation(fields: [saleId], references: [id])
  tenantId          String       @db.Uuid
  branchId          String       @db.Uuid
  amount            Decimal      @db.Decimal(12, 2)
  reason            String?
  processedByUserId String       @db.Uuid
  // Lets a retried/duplicate refund submission return the original refund
  // instead of restocking and crediting a second time.
  idempotencyKey    String
  // The processor's open shift at refund time, if any. Cash paid back to a
  // customer comes out of this shift's drawer, so shift reconciliation must
  // count it - unlike the original sale's shift, which isn't affected.
  shiftId           String?      @db.Uuid
  shift             Shift?       @relation(fields: [shiftId], references: [id])
  createdAt         DateTime     @default(now())
  lines             RefundLine[]

  @@unique([tenantId, idempotencyKey])
  @@index([saleId])
  @@index([tenantId, branchId, createdAt])
  @@index([shiftId])
  @@map("refunds")
}

model RefundLine {
  id         String   @id @default(uuid()) @db.Uuid
  refundId   String   @db.Uuid
  refund     Refund   @relation(fields: [refundId], references: [id])
  saleLineId String   @db.Uuid
  saleLine   SaleLine @relation(fields: [saleLineId], references: [id])
  quantity   Int
  amount     Decimal  @db.Decimal(12, 2)

  @@index([refundId])
  @@index([saleLineId])
  @@map("refund_lines")
}

// A local read-only projection for fast checkout lookup (barcode scan /
// search). Never authoritative - price and stock are always re-resolved
// against Product & Inventory synchronously at the moment of sale. Kept
// fresh by consuming ProductUpdated/PriceUpdated plus on-demand REST sync.
model CatalogCacheEntry {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  variantId     String   @db.Uuid
  productId     String   @db.Uuid
  productName   String
  articleNumber String?
  barcodes      String[]
  price         Decimal? @db.Decimal(12, 2)
  currency      String?
  lastSyncedAt  DateTime @default(now())

  @@unique([tenantId, variantId])
  @@map("catalog_cache_entries")
}

// Transactional outbox, same pattern as Product & Inventory: a row written
// in the same transaction as the business change, relayed to RabbitMQ by a
// separate poller so publishing can never be lost even if the broker is
// briefly unreachable.
model OutboxEvent {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  eventType    String
  eventVersion String    @default("v1")
  payload      Json
  createdAt    DateTime  @default(now())
  publishedAt  DateTime?

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}
