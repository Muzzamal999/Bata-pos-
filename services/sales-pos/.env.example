NODE_ENV=development
PORT=3004

DATABASE_URL=postgresql://sales_user:sales_pass@localhost:5435/sales_db?schema=public

# Must be identical to identity-organization's JWT_ACCESS_SECRET - this
# service verifies access tokens issued by Service 1, it does not issue its own.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-min-32-chars

PRODUCT_INVENTORY_BASE_URL=http://localhost:3002/api/v1

RABBITMQ_URL=amqp://bata:bata_pass@localhost:5672
SALES_POS_EXCHANGE=sales_pos.events
PRODUCT_INVENTORY_EXCHANGE=product_inventory.events
EVENT_CONSUMER_ENABLED=true
OUTBOX_RELAY_ENABLED=true
